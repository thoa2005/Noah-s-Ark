/* Main Menu Stylesheet - 100% Figma High Fidelity Color & Design System Mapping */

.menu-root-container {
    width: 100%;
    height: 100%;
    position: absolute;
    /* Base theme color s54 from Figma */
    background-color: #0a1440;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

/* Background Overlay Containers for Twinkle Stars and Floating Bubbles */
.bg-overlay-container {
    width: 100%;
    height: 100%;
    position: absolute;
}

/* Twinkling Stars s6 from Figma */
.star {
    position: absolute;
    width: 18px;
    height: 18px;
    background-color: #fff280;
    border-radius: 50%;
    opacity: 0.7;
}

/* Floating Bubbles s4 and s5 from Figma */
.bubble {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.04); /* s4 */
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.12); /* s5 */
    border-radius: 50%;
}

.bubble-sm {
    width: 30px;
    height: 30px;
}

.bubble-md {
    width: 65px;
    height: 65px;
}

.bubble-lg {
    width: 90px;
    height: 90px;
}

/* Wave Layers under the Sea (Figma exact styled bottom waves s1, s2, s3) */
.wave {
    position: absolute;
    bottom: 0;
    left: -20%;
    width: 140%;
    border-top-left-radius: 400px;
    border-top-right-radius: 400px;
}

.wave-back {
    height: 240px;
    background-color: rgba(6, 40, 100, 0.75); /* s1 */
    bottom: -30px;
}

.wave-front {
    height: 160px;
    background-color: rgba(13, 71, 161, 0.85); /* s2 */
    bottom: -15px;
}

.wave-foam {
    height: 85px;
    background-color: rgba(41, 182, 246, 0.35); /* s3 */
    bottom: 0px;
}

/* Centered Clustered Layout (Figma Aspect Ratio Perfect match) */
.menu-foreground {
    width: 100%;
    max-width: 1280px;
    height: 100%;
    position: absolute;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-self: center; /* Horizontally centers the entire menu panel */
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 70px;
    padding-bottom: 70px;
}

/* Columnar Sections */
.side-section {
    width: 320px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.left-section {
    align-items: flex-start;
}

.right-section {
    align-items: flex-end;
}

.center-section {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* Vertically center Title and Buttons to perfectly match Figma cluster */
    margin-left: 20px;
    margin-right: 20px;
}

/* Premium Glassmorphism Panels s17 & s16 from Figma */
.glass-panel {
    background-color: rgba(255, 255, 255, 0.1); /* s17 fills */
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2); /* s16 strokes */
    border-radius: 20px;
    padding: 24px;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.3s;
}

.glass-panel:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
}

/* Left Section: Player Card */
.player-card {
    width: 300px;
    position: relative;
    margin-bottom: 20px;
}

.player-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}

.avatar-bg {
    width: 64px;
    height: 64px;
    background-color: #fabf33; /* exact s48 / s18 avatar color */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.avatar-emoji {
    font-size: 36px;
}

.player-info {
    margin-left: 14px;
}

.player-name-text {
    font-size: 22px;
    color: #FFFFFF;
    -unity-font-style: bold;
}

.player-level-text {
    font-size: 14px;
    color: #ffe566; /* exact s19 level star color */
    -unity-font-style: bold;
}

.xp-container {
    width: 100%;
}

.xp-bar-bg {
    width: 100%;
    height: 16px;
    background-color: rgba(0, 0, 0, 0.4); /* s9 shadow/dark fill bg */
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 8px;
}

.xp-bar-fill {
    height: 100%;
    background-color: #2ed973; /* exact s10 green play color */
    border-radius: 7px;
}

.xp-progress-text {
    font-size: 12px;
    color: #b2ffd9; /* exact s54 green-tinged progress label */
    -unity-font-style: bold;
}

/* Center Section: Banner Title & Subtitle */
.title-wrapper {
    margin-top: 10px;
    align-items: center;
    display: flex;
    flex-direction: column;
}

.title-banner {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 20, 64, 0.55); /* s22 title shadow overlay */
    border-width: 3px;
    border-color: #05478c; /* s1 wave deep blue border */
    border-radius: 32px;
    padding: 10px 40px;
    margin-bottom: 16px;
}

.banner-anchor {
    font-size: 54px;
    color: #ffffff; /* Silver/white anchor */
    background-color: rgba(0, 0, 0, 0.35); /* Dark background container for the anchor icon */
    border-radius: 16px;
    padding: 6px 16px;
    margin-right: 24px;
    -unity-font-style: bold;
}

.menu-title {
    font-size: 76px;
    color: #ffeb4d; /* s7 title gold color */
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.menu-subtitle {
    font-size: 22px;
    color: #bfedff; /* s8 subtitle blue text */
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.button-container {
    width: 320px;
    margin-top: 50px; /* Elegant gap between Title and Buttons, matching Figma */
    margin-bottom: 20px;
}

/* Figma Perfect Buttons Styling with 3D Pop Effect */
.btn {
    width: 100%;
    height: 60px;
    border-radius: 20px;
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 14px;
    border-width: 2px;
    border-bottom-width: 5px; /* 3D pop shadow! */
    border-color: rgba(255, 255, 255, 0.4);
    border-bottom-color: rgba(0, 0, 0, 0.35); /* exact bottom shadow */
    color: #FFFFFF;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-in-out;
}

.btn:hover {
    scale: 1.04;
}

.btn:active {
    scale: 0.96;
}

/* Quick Play (Green s10) */
.btn-primary {
    background-color: #2ed973;
}

.btn-primary:hover {
    background-color: #3bf084;
}

/* Create Room (Orange s13) */
.btn-orange {
    background-color: #faa61a;
}

.btn-orange:hover {
    background-color: #ffbb3d;
}

/* Join Room (Blue s14) */
.btn-blue {
    background-color: #4099ff;
}

.btn-blue:hover {
    background-color: #66b2ff;
}

.sub-button-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

/* Dedicated Sub-button base style (avoids chained USS selectors completely) */
.btn-sub {
    height: 52px;
    border-radius: 16px;
    font-size: 16px;
    -unity-font-style: bold;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: rgba(255, 255, 255, 0.4);
    border-bottom-color: rgba(0, 0, 0, 0.3);
    color: #FFFFFF;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-in-out;
}

.btn-sub:hover {
    scale: 1.04;
}

.btn-sub:active {
    scale: 0.96;
}

.btn-grey {
    width: 48%;
    background-color: rgba(100, 116, 139, 0.75); /* Slate gray matching Figma */
}

.btn-grey:hover {
    background-color: rgba(120, 136, 159, 0.9);
}

.btn-purple {
    width: 48%;
    background-color: #8c4dd9; /* Profile purple */
}

.btn-purple:hover {
    background-color: #a366f2;
}

/* Right Section: Season news Card & Online counter */
.season-card {
    width: 300px;
    margin-bottom: 24px;
    background-color: #ff5e36; /* Coral orange matching Figma gradient midpoint */
    border-color: rgba(255, 255, 255, 0.4);
}

.season-tag {
    font-size: 14px;
    color: #FFFFFF;
    -unity-font-style: bold;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.season-title {
    font-size: 22px;
    color: #FFFFFF;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.season-desc {
    font-size: 15px;
    color: #ffe5e5; /* s43 light pink description text */
    white-space: normal;
}

.online-badge {
    width: 300px; /* match season card width exactly! */
    padding: 12px 20px;
    border-radius: 16px;
    background-color: rgba(15, 23, 42, 0.55);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
}

.online-indicator {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.online-dot {
    width: 12px;
    height: 12px;
    background-color: #2ed973; /* matching vibrant green online dot */
    border-radius: 50%;
    margin-right: 12px;
}

.online-count-text {
    font-size: 16px;
    color: #d9ffe5; /* exact s46 light green text */
    -unity-font-style: bold;
}

/* Footer Version */
.footer-version {
    position: absolute;
    bottom: 20px;
    align-self: center;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.3); /* exact s20 version text color */
    -unity-font-style: bold;
}
