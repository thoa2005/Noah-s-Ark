/* CharacterSelect.uss — matched to Figma "03 - Ship & Character Select" */

/* ===== ROOT ===== */
.cs-root {
    width: 100%;
    height: 100%;
    position: absolute;
    background-color: #0a1440;
    overflow: hidden;
    flex-direction: column;
}

/* ===== BACKGROUND WAVES ===== */
.cs-bg {
    width: 100%;
    height: 100%;
    position: absolute;
}

.cs-wave {
    position: absolute;
    bottom: 0;
    left: -20%;
    width: 140%;
    border-top-left-radius: 400px;
    border-top-right-radius: 400px;
}

.cs-wave-back {
    height: 200px;
    background-color: rgba(6, 40, 100, 0.75);
    bottom: -30px;
}

.cs-wave-front {
    height: 130px;
    background-color: rgba(13, 71, 161, 0.85);
    bottom: -15px;
}

.cs-wave-foam {
    height: 70px;
    background-color: rgba(41, 182, 246, 0.35);
    bottom: 0;
}

/* ===== TOP BAR (Figma: height 68, bg #00000059) ===== */
.cs-topbar {
    width: 100%;
    height: 68px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 24px;
    padding-right: 24px;
    background-color: rgba(0, 0, 0, 0.35);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

/* Figma: "👤 Choose Your Captain" — Nunito Black 26px white */
.cs-topbar-title {
    font-size: 26px;
    color: #ffffff;
    -unity-font-style: bold;
}

/* Figma: Timer BG — #ff334dd9, radius 12, 120×40 */
.cs-timer-badge {
    background-color: rgba(255, 51, 77, 0.85);
    border-radius: 12px;
    padding: 5px 16px;
}

/* Figma: "⏱ 0:28" — Nunito Black 22px white */
.cs-timer-text {
    font-size: 22px;
    color: #ffffff;
    -unity-font-style: bold;
}

/* ===== GLASS PANEL (Figma: #ffffff0f, stroke #ffffff24, radius 24) ===== */
.cs-glass {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    padding: 16px;
}

/* ===== MAIN CONTENT ROW ===== */
.cs-content {
    flex-grow: 1;
    flex-direction: row;
    padding: 12px 20px;
    align-items: stretch;
}

/* ===== LEFT: 3D VIEWPORT (Figma: 840×720, stroke #4099ff30) ===== */
.cs-viewport-panel {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    margin-right: 12px;
    border-color: rgba(64, 153, 255, 0.19);
}

/* Figma: "🎮 3D CHARACTER VIEW" — 13px Bold, #4099ff40 */
.cs-viewport-label {
    font-size: 13px;
    color: rgba(64, 153, 255, 0.25);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 10px;
    align-self: flex-start;
}

.cs-preview-container {
    flex-grow: 1;
    width: 100%;
    border-radius: 12px;
    background-color: rgba(10, 20, 60, 0.8);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    /* Không dùng background-size: cover vì sẽ upscale RT → mờ */
    /* RT được resize pixel-perfect bằng code (OnPreviewContainerResized) */
}

/* Figma: character name — Nunito Black 36px white */
.cs-character-name {
    font-size: 36px;
    color: #ffffff;
    -unity-font-style: bold;
    margin-top: 14px;
    align-self: center;
}

.cs-drag-hint {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.35);
    margin-top: 4px;
    align-self: center;
}

/* ===== RIGHT COLUMN ===== */
.cs-right-col {
    width: 42%;
    flex-direction: column;
}

/* ===== SECTION SHARED ===== */
.cs-section {
    margin-bottom: 10px;
}

/* Captain section: fixed height so scroll works */
.cs-captain-section {
    height: 55%;
    flex-direction: column;
}

/* Figma: section title — Nunito Black 18px #bfedffd9 */
.cs-section-title {
    font-size: 18px;
    color: rgba(191, 237, 255, 0.85);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.cs-section-title-players {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.38);
}

/* ===== SCROLLBAR STYLING — Unity UI Toolkit correct selectors ===== */

/* Toàn bộ scroller container */
.unity-scroller--vertical {
    width: 6px;
    margin-left: 6px;
    background-color: rgba(0, 0, 0, 0);
}

/* Ẩn 2 nút mũi tên (high/low buttons) */
#unity-high-button,
#unity-low-button {
    display: none;
    width: 0;
    height: 0;
}

/* Track (nền thanh) */
#unity-tracker {
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 3px;
    border-width: 0;
    margin: 0;
}

/* Thumb (nút kéo) */
#unity-dragger {
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
    border-width: 0;
    width: 6px;
    min-height: 20px;
    margin: 0;
}

#unity-dragger:hover {
    background-color: rgba(255, 255, 255, 0.55);
}

#unity-dragger:active {
    background-color: rgba(255, 255, 255, 0.75);
}

/* ===== CAPTAIN SCROLL WRAPPER ===== */
.cs-captain-scroll {
    flex-grow: 1;
    overflow: hidden;
}

/* ===== CAPTAIN GRID (3 per row) ===== */
.cs-captain-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding-bottom: 4px;
}

/* ===== PLAYERS SCROLL ===== */
.cs-players-scroll {
    flex-grow: 1;
    overflow: hidden;
}

/* Figma: cap card — radius 16, #ffffff12, stroke #ffffff1f, 158×160 */
.cs-cap-card {
    width: 31%;
    margin: 1%;
    padding: 10px 4px;
    flex-direction: column;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
    cursor: link;
}

.cs-cap-card:hover {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.3);
    scale: 1.04;
}

/* Figma: selected — #ff4d5938, stroke #ff4d59 */
.cs-cap-selected {
    background-color: rgba(255, 77, 89, 0.22);
    border-color: #ff4d59;
    border-width: 2px;
}

/* Figma: locked — #26264099, stroke #66668066 */
.cs-cap-locked {
    background-color: rgba(38, 38, 64, 0.6);
    border-color: rgba(102, 102, 128, 0.4);
    border-width: 1.5px;
}

/* Figma: captain emoji — 44px */
.cs-cap-icon {
    font-size: 44px;
    margin-bottom: 6px;
}

/* Figma: captain name — Nunito Black 13px white */
.cs-cap-name {
    font-size: 13px;
    color: #ffffff;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Figma: locked name — #808099 */
.cs-cap-name-locked {
    color: rgba(128, 128, 153, 1);
}

.cs-cap-lock-icon {
    font-size: 14px;
    margin-top: 4px;
    color: rgba(128, 128, 153, 1);
}

/* Figma: checkmark — green dot */
.cs-cap-check {
    width: 16px;
    height: 16px;
    background-color: #2ed973;
    border-radius: 50%;
    margin-top: 6px;
}

.cs-hidden {
    display: none;
}

/* ===== PLAYERS IN ROOM ===== */
.cs-players-section {
    flex-grow: 1;
    min-height: 140px;
}

.cs-player-list {
    flex-direction: column;
}

/* Figma: player row — radius 12, #ffffff08, height 38 */
.cs-player-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    border-radius: 12px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

/* Figma: YOU row — #2ed97318, stroke #2ed97340 */
.cs-player-you {
    background-color: rgba(46, 217, 115, 0.09);
    border-width: 1px;
    border-color: rgba(46, 217, 115, 0.25);
}

/* Figma: YOU tag — #2ed973, radius 6, 34×18 */
.cs-you-tag {
    font-size: 10px;
    color: #ffffff;
    -unity-font-style: bold;
    background-color: #2ed973;
    border-radius: 6px;
    padding: 2px 5px;
    margin-right: 6px;
}

/* Figma: player emoji — 20px */
.cs-player-emoji {
    font-size: 20px;
    margin-right: 8px;
}

.cs-player-info {
    flex-grow: 1;
    flex-direction: column;
}

/* Figma: player name — Nunito Black 14px white */
.cs-player-name {
    font-size: 14px;
    color: #ffffff;
    -unity-font-style: bold;
}

/* Figma: player char — 12px Bold #ffffff50 */
.cs-player-char {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.31);
    -unity-font-style: bold;
}

/* Figma: status badge — 11px Black */
.cs-player-status {
    font-size: 11px;
    -unity-font-style: bold;
    padding: 3px 8px;
    border-radius: 6px;
}

/* Figma: ready — #2ed973 bg */
.cs-status-ready {
    background-color: #2ed973;
    color: #ffffff;
}

/* Figma: selecting — #fabf1a40 bg, #fabf1a text */
.cs-status-selecting {
    background-color: rgba(250, 191, 26, 0.25);
    color: #fabf1a;
}

/* ===== FOOTER ===== */
.cs-footer {
    height: 80px;
    align-items: center;
    justify-content: center;
    padding-bottom: 12px;
}

/* Figma: Confirm Button — radius 20, stroke #ffffff4d, 360×56 */
.cs-btn-lockin {
    width: 360px;
    height: 56px;
    background-color: #faa61a;
    border-radius: 20px;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: rgba(255, 255, 255, 0.3);
    border-bottom-color: rgba(0, 0, 0, 0.3);
    color: #ffffff;
    font-size: 26px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.cs-btn-lockin:hover {
    background-color: #ffbb3d;
    scale: 1.04;
}

.cs-btn-lockin:active {
    scale: 0.96;
}

/* ===== DRAG OVERLAY ===== */
.cs-drag-overlay {
    position: absolute;
    left: 0;
    top: 68px;
    width: 58%;
    bottom: 80px;
    background-color: rgba(0, 0, 0, 0);
}
